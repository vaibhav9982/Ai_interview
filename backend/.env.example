# =============================================
# AI Interview App - Backend Environment Variables
# =============================================

# Server
PORT=5000
NODE_ENV=development

# Redis (Set to false if you don't have Redis running locally)
REDIS_ENABLED=false

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_interview_db?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_min_32_chars
JWT_REFRESH_EXPIRE=30d

# Groq AI (Free LLM API - https://console.groq.com)
GROQ_API_KEY=

# Hugging Face (Free Embeddings - https://huggingface.co/settings/tokens)
# Token must have "Make calls to Inference Providers" permission
HF_TOKEN=

# Cloudinary (Resume/File Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend URL (CORS)
CLIENT_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
